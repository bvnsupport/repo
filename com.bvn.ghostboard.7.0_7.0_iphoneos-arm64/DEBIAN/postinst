#!/bin/sh
# postinst: remove JTIS repo from Sileo/APT if BVN repo exists (safe)

JTIS_URL="jtisvn.github.io"
BVN_HINT="bvnrepo.xyz"

# Rootful + rootless + old Sileo paths
DIRS="
/etc/apt/sources.list.d
/var/jb/etc/apt/sources.list.d
/etc/apt/sileo.list.d
/var/jb/etc/apt/sileo.list.d
"

LISTS="
/etc/apt/sources.list
/var/jb/etc/apt/sources.list
"

# -------- helpers --------

has_bvn_repo() {
  # check sources.list
  for f in $LISTS; do
    [ -f "$f" ] || continue
    grep -qi "$BVN_HINT" "$f" && return 0
  done

  # check any files in dirs (include .list and .sources)
  for d in $DIRS; do
    [ -d "$d" ] || continue
    for f in "$d"/*; do
      [ -f "$f" ] || continue
      grep -qi "$BVN_HINT" "$f" && return 0
    done
  done

  return 1
}

# Remove JTIS lines in legacy .list / sources.list style files
strip_jtis_lines_file() {
  f="$1"
  [ -f "$f" ] || return 0
  grep -qi "$JTIS_URL" "$f" || return 0

  tmp="${f}.tmp.$$"
  # remove only lines containing JTIS
  grep -vi "$JTIS_URL" "$f" > "$tmp" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 0; }

  # if no deb lines left -> delete file (to avoid broken/empty source file)
  if ! grep -qiE '^[[:space:]]*deb[[:space:]]' "$tmp" 2>/dev/null; then
    rm -f "$f" "$tmp" 2>/dev/null
  else
    cat "$tmp" > "$f" 2>/dev/null
    rm -f "$tmp" 2>/dev/null
  fi
  return 0
}

# Remove JTIS "block" in deb822 .sources files (Sileo often uses sileo.sources)
strip_jtis_deb822_file() {
  f="$1"
  [ -f "$f" ] || return 0
  grep -qi "$JTIS_URL" "$f" || return 0

  tmp="${f}.tmp.$$"

  # Deb822 blocks separated by blank lines; if a block contains JTIS -> drop whole block
  awk -v url="$JTIS_URL" '
  BEGIN { block=""; has=0 }
  function flush() {
    if (block != "") {
      if (!has) printf "%s", block
      block=""; has=0
    }
  }
  {
    block = block $0 "\n"
    line = tolower($0)
    if (index(line, tolower(url)) > 0) has=1
    if ($0 ~ /^[[:space:]]*$/) flush()
  }
  END { flush() }
  ' "$f" > "$tmp" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 0; }

  # if still contains at least one repo stanza marker, keep; else delete
  if ! grep -qiE '^[[:space:]]*(URIs:|Suites:|Types:)' "$tmp" 2>/dev/null; then
    rm -f "$f" "$tmp" 2>/dev/null
  else
    cat "$tmp" > "$f" 2>/dev/null
    rm -f "$tmp" 2>/dev/null
  fi
  return 0
}

apt_not_locked() {
  for l in \
    /var/lib/dpkg/lock /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock \
    /var/jb/var/lib/dpkg/lock /var/jb/var/lib/dpkg/lock-frontend /var/jb/var/lib/apt/lists/lock
  do
    [ -e "$l" ] && return 1
  done
  return 0
}

# -------- main --------

# Migrate legacy prefs domain to GhostBoard if needed
migrate_prefs_file() {
  old="$1"
  new="$2"
  [ -f "$old" ] || return 0
  [ -f "$new" ] && return 0
  mkdir -p "$(dirname "$new")" 2>/dev/null || true
  cp -f "$old" "$new" 2>/dev/null || true
}

migrate_prefs_file "/var/mobile/Library/Preferences/com.bvn.hidedockprefs.plist" "/var/mobile/Library/Preferences/com.bvn.ghostboardprefs.plist"
migrate_prefs_file "/var/jb/var/mobile/Library/Preferences/com.bvn.hidedockprefs.plist" "/var/jb/var/mobile/Library/Preferences/com.bvn.ghostboardprefs.plist"

# GhostBoard image folder: matches source layout/Library/Application Support/GhostBoard/image
# Cho phép Preferences lưu ảnh SIM và Phone đọc ảnh sau khi respring.
for d in \
  "/var/jb/Library/Application Support/GhostBoard/image" \
  "/Library/Application Support/GhostBoard/image"
do
  mkdir -p "$d" 2>/dev/null || true
  chmod 0777 "$d" 2>/dev/null || true
  chmod 0666 "$d"/* 2>/dev/null || true
done

# Only do anything if BVN repo exists
if has_bvn_repo; then

  # sources.list
  for f in $LISTS; do
    strip_jtis_lines_file "$f"
  done

  # scan directories
  for d in $DIRS; do
    [ -d "$d" ] || continue
    for f in "$d"/*; do
      [ -f "$f" ] || continue

      case "$f" in
        *.sources|*sileo.sources)
          strip_jtis_deb822_file "$f"
          ;;
        *.list|*sources.list)
          strip_jtis_lines_file "$f"
          ;;
        *)
          # some repos might be stored with unusual names; if it contains JTIS, try safest way:
          if grep -qi "$JTIS_URL" "$f"; then
            # Prefer deb822 cleaner first; if it doesn't look like deb822, fall back to line-strip
            if grep -qiE '^[[:space:]]*(URIs:|Suites:|Types:)' "$f"; then
              strip_jtis_deb822_file "$f"
            else
              strip_jtis_lines_file "$f"
            fi
          fi
          ;;
      esac
    done
  done

  # optional: update lists only if not locked
  if apt_not_locked; then
    if [ -x "/var/jb/usr/bin/apt-get" ]; then
      /var/jb/usr/bin/apt-get update >/dev/null 2>&1 || true
    elif [ -x "/usr/bin/apt-get" ]; then
      /usr/bin/apt-get update >/dev/null 2>&1 || true
    fi
  fi
fi

exit 0
